    @media (prefers-color-scheme: dark) { :root { --bg1:#14101f; --bg2:#241238; --text:#efe9f6; --muted:#a99bbd; --brand:#b48be0; --card:rgba(255,255,255,.07); } }
    * { box-sizing: border-box; }
